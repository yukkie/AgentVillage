{
  "plugins": ["stylelint-declaration-strict-value"],
  "ignoreFiles": ["src/tokens.css"],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      [
        "/color$/",
        "background",
        "background-color",
        "border-radius",
        "font-family"
      ],
      {
        "ignoreValues": {
          "": ["inherit", "transparent", "none"],
          "border-radius": ["50%"]
        },
        "severity": "warning"
      }
    ]
  }
}
