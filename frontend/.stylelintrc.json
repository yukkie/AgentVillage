{
  "plugins": ["stylelint-declaration-strict-value"],
  "ignoreFiles": ["src/tokens.css"],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      [
        "/color$/",
        "background",
        "background-color",
        "border-radius",
        "font-family",
        "font-size"
      ],
      {
        "ignoreValues": {
          "": ["inherit", "transparent", "none"],
          "border-radius": ["50%", "0", "inherit"],
          "background": [
            "inherit",
            "transparent",
            "none",
            "/^radial-gradient\\(/"
          ],
          "font-size": [
            "16px",
            "18px",
            "24px",
            "26px",
            "32px",
            "/^clamp\\(/"
          ]
        },
        "severity": "error"
      }
    ]
  }
}
